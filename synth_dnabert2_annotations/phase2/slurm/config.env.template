#!/bin/bash
################################################################################
# SLURM Environment Configuration Template
#
# This file contains environment variables for SLURM job scripts.
# Copy this file to config.env and modify paths for your system.
#
# Usage:
#   cp config.env.template config.env
#   nano config.env  # Edit paths
#   source config.env
#
# IMPORTANT: config.env is excluded from version control (.gitignore)
################################################################################

# ============================================================================
# Project Paths
# ============================================================================

# Root directory of the project
export PROJECT_ROOT="/path/to/synth_dnabert2_annotations"

# Phase directories
export PHASE1_DIR="${PROJECT_ROOT}/phase1"
export PHASE2_DIR="${PROJECT_ROOT}/phase2"

# ============================================================================
# Data Paths
# ============================================================================

# InpactorDB2 database (Phase 1)
export INPACTORDB_PATH="/path/to/inpactordb2.fasta"

# Species index and GC data (Phase 1)
export SPECIES_INDEX="${PHASE1_DIR}/resultados/species_index_v2.json"
export SPECIES_GC_DATA="${PHASE1_DIR}/resultados/species_gc_data_v2.csv"

# Synthetic genomes output directory (Phase 1)
export SYNTHETIC_GENOMES_DIR="${PHASE1_DIR}/synthetic_genomes"

# Datasets directory (Phase 2 - tokenized datasets)
export DATASETS_DIR="${PHASE2_DIR}/datasets"

# Combined datasets directory (Phase 2)
export DATASETS_COMBINED_DIR="${PHASE2_DIR}/datasets_combined"

# Results directory (Phase 2 - training outputs)
export RESULTS_DIR="${PHASE2_DIR}/results"

# Models directory (Phase 2 - saved models)
export MODELS_DIR="${PHASE2_DIR}/models"

# ============================================================================
# SLURM Configuration
# ============================================================================

# SLURM account name (modify to your account)
export SLURM_ACCOUNT="your_account"

# SLURM partition for GPU jobs
export SLURM_PARTITION="gpu"

# SLURM partition for CPU jobs
export SLURM_PARTITION_CPU="cpu"

# SLURM partition for fast/debug jobs
export SLURM_PARTITION_FAST="fast"

# Email for SLURM notifications
export SLURM_MAIL_USER="your_email@domain.com"

# ============================================================================
# Conda Environment
# ============================================================================

# Conda environment name for Phase 2 (DNABERT-2)
export CONDA_ENV="dnabert2_te"

# Conda environment name for Phase 1 (optional, if different)
export CONDA_ENV_PHASE1="te_phase1"

# Path to conda installation (if not in default location)
# export CONDA_PATH="${HOME}/anaconda3"

# ============================================================================
# Computational Resources (Defaults)
# ============================================================================

# Default memory allocation
export DEFAULT_MEM="64GB"

# Default time limit for training jobs
export DEFAULT_TIME_TRAINING="2-00:00:00"  # 2 days

# Default time limit for evaluation jobs
export DEFAULT_TIME_EVAL="0-04:00:00"  # 4 hours

# Default time limit for data preparation jobs
export DEFAULT_TIME_PREP="0-12:00:00"  # 12 hours

# Number of CPUs per task
export DEFAULT_CPUS=8

# Number of GPUs per task
export DEFAULT_GPUS=1

# ============================================================================
# Python Environment Variables
# ============================================================================

# Unbuffered Python output (recommended for SLURM logs)
export PYTHONUNBUFFERED=1

# Disable tokenizers parallelism (avoids warnings)
export TOKENIZERS_PARALLELISM=false

# PyTorch CUDA memory optimization
export PYTORCH_CUDA_ALLOC_CONF="expandable_segments:True"

# ============================================================================
# Additional Paths (Optional)
# ============================================================================

# TEgenomeSimulator directory (Phase 1)
# export TEGENOME_SIMULATOR_DIR="${PHASE1_DIR}/TEgenomeSimulator"

# FlyBase reference genomes (Phase 2 - for evaluation)
# export FLYBASE_GENOME="${PHASE2_DIR}/data/dmel-all-chromosome-r6.66.fasta.gz"
# export FLYBASE_TES="${PHASE2_DIR}/data/dmel-all-transposon-r6.66.fasta.gz"

# ============================================================================
# Validation
# ============================================================================

# Uncomment to validate that required directories exist
# if [ ! -d "$PROJECT_ROOT" ]; then
#     echo "ERROR: PROJECT_ROOT does not exist: $PROJECT_ROOT"
#     exit 1
# fi

################################################################################
# End of Configuration
################################################################################
